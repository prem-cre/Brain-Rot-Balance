{
  "manifest_version": 3,
  "name": "Brain-Rot Balance",
  "description": "Learn first. Enjoy guilt-free entertainment later.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Brain-Rot Balance",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "src/content/youtube-overlay.js"
      ],
      "css": [
        "src/styles/theme.css",
        "src/content/youtube-overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}


